# Copy to .env and fill in your own keys:  cp .env.example .env
# NEVER commit the real .env — it is gitignored.

# ---- Reasoning: NVIDIA Nemotron via NIM (OpenAI-compatible) ----
# Get a free key at build.nvidia.com (starts with nvapi-)
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-nano-30b-a3b

# ---- Voice: Pipecat + Daily + STT/TTS ----
DAILY_API_KEY=your-daily-api-key
DAILY_ROOM_URL=https://YOUR-DOMAIN.daily.co/sentry
DEEPGRAM_API_KEY=your-deepgram-api-key
ELEVENLABS_API_KEY=your-elevenlabs-api-key
# Optional: override the default ElevenLabs voice
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# ---- Adversary + eval: Cekura ----
CEKURA_API_KEY=your-cekura-api-key
CEKURA_BASE_URL=https://api.cekura.ai
# Set CEKURA_MOCK=1 to run the full red->green loop offline (no Cekura account needed)
# CEKURA_MOCK=1

# ---- Orchestrator ----
ORCHESTRATOR_URL=http://localhost:8080
PATCH_WRITER_TIMEOUT_SECONDS=12

# ---- AWS (optional; default to NIM-hosted Nemotron) ----
AWS_REGION=us-west-2
